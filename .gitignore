back/uploads/*
!back/uploads/.gitkeep
!back/uploads/plats/
back/uploads/plats/*
!back/uploads/plats/.gitkeep
!back/uploads/menus/
back/uploads/menus/*
!back/uploads/menus/.gitkeep
