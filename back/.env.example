# ============================================
# Vite & Gourmand — Configuration back-end
# ============================================
# Copiez ce fichier en .env et remplissez les valeurs réelles.
# NE JAMAIS commiter le fichier .env (déjà dans .gitignore).

# --- Serveur ---
PORT=3000
NODE_ENV=development
# NODE_ENV : "development" en local, "production" sur Render

# --- Base de données PostgreSQL ---
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=vite_et_gourmand
PG_USER=votre_utilisateur_pg
PG_PASSWORD=votre_mot_de_passe_pg

# --- Base de données MongoDB (sessions, tokens, events) ---
MONGO_URI=mongodb+srv://utilisateur:motdepasse@cluster.mongodb.net/vite_et_gourmand?retryWrites=true&w=majority
# En local : mongodb://localhost:27017/vite_et_gourmand
# En prod : URL fournie par MongoDB Atlas

# --- Sécurité des sessions ---
SESSION_SECRET=remplacer_par_une_chaine_aleatoire_de_64_caracteres_minimum
# Pour générer : utilisez https://generate-secret.vercel.app/64
# Ou en ligne de commande : openssl rand -base64 64

# --- Service d'envoi d'emails (Mailtrap en dev) ---
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=votre_user_mailtrap
MAIL_PASSWORD=votre_mot_de_passe_mailtrap
MAIL_CONTACT=contact@vite-et-gourmand.fr
# MAIL_CONTACT : adresse d'envoi affichée aux clients
# En prod : configurer un vrai service SMTP (SendGrid, Mailgun, etc.)

# --- URL du front-end ---
FRONT_URL=http://localhost:5173
# En local Vite : http://localhost:5173
# En prod : https://vite-et-gourmand.onrender.com (ou votre domaine)
